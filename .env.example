PORT=10267

# External auth service that signs the JWTs this service verifies
AUTH_API_BASE_URL=http://localhost:10067

# Database
BLUEPRINT_DB_DATABASE=noura_todos_db
BLUEPRINT_DB_PASSWORD=postgres
BLUEPRINT_DB_USERNAME=postgres
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_SCHEMA=todos
# Defaults to "require"; set "disable" only for local Postgres without TLS
BLUEPRINT_DB_SSLMODE=disable

# Used by the Makefile migrate-* targets (sslmode appended automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noura_todos_db

# JWT — REQUIRED, service refuses to start with empty or placeholder values.
# Must match the secret/issuer the auth service signs tokens with
# (minimum 32 characters).
JWT_ACCESS_TOKEN_SECRET=
JWT_ISSUER=

# Comma-separated allowlist; empty means allow all origins (dev only)
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Optional error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Debug/pprof server (loopback only)
DEBUG_PORT=4000
